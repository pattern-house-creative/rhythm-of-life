{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/revalidate.output.schema.json",
  "title": "revalidate answer",
  "description": "The memory tool revalidate's answer (SB-P4-10, migration 055; story 7): each citation of the memory the caller is served (or the one document named) checked at its source now, and what was recorded. citations: each as it is now, with what this check found; revalidated: each citation this call moved, from and to which revision and checked state, and what changed (edited, moved, renamed, revised); unchecked: how many the source did not answer for, which stay as they were. Never silent: every move is listed, and kept on the citation (revalidated_at, earlier_revision). Nothing in the memory changed: its revision is the one it had. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body (held: a memory held for review; unknown_document: the memory cites no such document the caller reads).",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "id",
        "revision",
        "scope",
        "owner",
        "status",
        "scopes",
        "citations",
        "revalidated",
        "unchecked",
        "message",
        "notice"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "id": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "revision": {
          "$ref": "memory.defs.schema.json#/$defs/revision"
        },
        "scope": {
          "$ref": "memory.defs.schema.json#/$defs/scope"
        },
        "owner": {
          "$ref": "memory.defs.schema.json#/$defs/subject"
        },
        "status": {
          "$ref": "memory.defs.schema.json#/$defs/status"
        },
        "scopes": {
          "$ref": "memory.defs.schema.json#/$defs/scopes"
        },
        "citations": {
          "$ref": "memory.defs.schema.json#/$defs/citations"
        },
        "revalidated": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "citation",
              "from_revision",
              "to_revision",
              "from_state",
              "to_state",
              "changes"
            ],
            "properties": {
              "citation": {
                "$ref": "memory.defs.schema.json#/$defs/uuid"
              },
              "from_revision": {
                "$ref": "memory.defs.schema.json#/$defs/sourceRevision"
              },
              "to_revision": {
                "$ref": "memory.defs.schema.json#/$defs/sourceRevision"
              },
              "from_state": {
                "$ref": "memory.defs.schema.json#/$defs/citationState"
              },
              "to_state": {
                "$ref": "memory.defs.schema.json#/$defs/citationState"
              },
              "changes": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "edited",
                    "moved",
                    "renamed",
                    "revised"
                  ]
                }
              }
            }
          }
        },
        "unchecked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "notice": {
          "$ref": "memory.defs.schema.json#/$defs/notice"
        }
      }
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
