{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/list_recent.output.schema.json",
  "title": "list_recent answer",
  "description": "The memory tool list_recent's answer (SB-P3-09): memories newest first, each with a preview of up to 500 characters, or with in_trash the trash the caller may bring back, newest trashed first; next continues the list. A held memory is listed without its words, tags or project. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "in_trash",
        "memories",
        "trash",
        "next",
        "notice"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "in_trash": {
          "type": "boolean"
        },
        "memories": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "memory.defs.schema.json#/$defs/memory"
          }
        },
        "trash": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "memory.defs.schema.json#/$defs/trashItem"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,200}$",
          "description": "Pass as cursor for the next page; null at the end."
        },
        "notice": {
          "$ref": "memory.defs.schema.json#/$defs/notice"
        }
      },
      "anyOf": [
        {
          "properties": {
            "in_trash": {
              "const": false
            },
            "trash": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "in_trash": {
              "const": true
            },
            "memories": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
