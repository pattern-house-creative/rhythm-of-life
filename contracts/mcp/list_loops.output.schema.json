{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/list_loops.output.schema.json",
  "title": "list_loops answer",
  "description": "The memory tool list_loops' answer (SB-P5-09, migration 058): the caller's own open loops, newest first. An open loop is a memory tagged task and not task:done nor an agent's build note, live, not held, not marked wrong and with its window open (058's memory_open_loop, one predicate). direction is the list asked: out (what the person owes), in (what is owed to them) or all. total is that list's whole length for this caller, and you_owe and owed_to_you the lengths of the out and in lists under the same filters, all read in the same statement as the page, so each count is the length of its list. Only loops the caller may resolve and owns: its person's private ones, and the Family ones its person wrote or no person wrote (a Family admin is not listed another member's). counterparty is the other person's name, words made from its slug, or null. content is a preview of up to 500 characters, truncated when longer; a held memory is never listed. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "direction",
        "total",
        "you_owe",
        "owed_to_you",
        "loops",
        "next",
        "notice"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "direction": {
          "enum": [
            "out",
            "in",
            "all"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "you_owe": {
          "type": "integer",
          "minimum": 0,
          "description": "How many open loops the person owes (direction out), under the same filters."
        },
        "owed_to_you": {
          "type": "integer",
          "minimum": 0,
          "description": "How many open loops are owed to the person (direction in), under the same filters."
        },
        "loops": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/loop"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,200}$",
          "description": "Pass as cursor for the next page; null at the end."
        },
        "notice": {
          "$ref": "memory.defs.schema.json#/$defs/notice"
        }
      },
      "anyOf": [
        {
          "properties": {
            "direction": {
              "const": "all"
            }
          }
        },
        {
          "properties": {
            "direction": {
              "const": "out"
            },
            "loops": {
              "items": {
                "properties": {
                  "direction": {
                    "const": "out"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "direction": {
              "const": "in"
            },
            "loops": {
              "items": {
                "properties": {
                  "direction": {
                    "const": "in"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ],
  "$defs": {
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "scope",
        "owner",
        "author",
        "status",
        "direction",
        "counterparty",
        "tags",
        "project",
        "created_at",
        "content",
        "truncated"
      ],
      "properties": {
        "id": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "revision": {
          "$ref": "memory.defs.schema.json#/$defs/revision"
        },
        "scope": {
          "$ref": "memory.defs.schema.json#/$defs/scope"
        },
        "owner": {
          "$ref": "memory.defs.schema.json#/$defs/subject"
        },
        "author": {
          "$ref": "memory.defs.schema.json#/$defs/person"
        },
        "status": {
          "enum": [
            "canonical",
            "draft"
          ]
        },
        "direction": {
          "$ref": "memory.defs.schema.json#/$defs/loopDirection"
        },
        "counterparty": {
          "$ref": "memory.defs.schema.json#/$defs/counterparty"
        },
        "tags": {
          "$ref": "memory.defs.schema.json#/$defs/tags",
          "minItems": 1
        },
        "project": {
          "$ref": "memory.defs.schema.json#/$defs/writtenProject"
        },
        "created_at": {
          "$ref": "memory.defs.schema.json#/$defs/instant",
          "description": "When it was written."
        },
        "content": {
          "type": "string",
          "maxLength": 500
        },
        "truncated": {
          "type": "boolean",
          "description": "content is a preview: get reads the whole text."
        }
      }
    }
  }
}
