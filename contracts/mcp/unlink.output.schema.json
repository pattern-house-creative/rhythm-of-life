{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/unlink.output.schema.json",
  "title": "unlink answer",
  "description": "The memory tool unlink's answer (SB-P4-02, migration 052): what one call did between two memories, either way round (source and target as named). removed: the made links it deleted (a person's or an AI client's, each removed only by its maker or whoever may change its source memory); kept: the made links marked suggested it dismissed, each removed and its two memories and type kept as a dismissal (never as a link), so it is never suggested again until a link of its type is made between them; dismissed: the types of the map's own suggestions between the two memories it dismissed, for good, through every rebuild. unchanged: it did nothing (no link of that type, or the suggestion was dismissed already). scope, owner and scopes are the source memory's and the install's. No memory's words. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "source",
        "target",
        "removed",
        "kept",
        "dismissed",
        "unchanged",
        "scope",
        "owner",
        "scopes",
        "message"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "source": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "target": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "removed": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "memory.defs.schema.json#/$defs/uuid"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        },
        "kept": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "memory.defs.schema.json#/$defs/uuid"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        },
        "dismissed": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "unchanged": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "memory.defs.schema.json#/$defs/scope"
        },
        "owner": {
          "$ref": "memory.defs.schema.json#/$defs/subject"
        },
        "scopes": {
          "$ref": "memory.defs.schema.json#/$defs/scopes"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "anyOf": [
        {
          "properties": {
            "unchanged": {
              "const": true
            },
            "removed": {
              "maxItems": 0
            },
            "kept": {
              "maxItems": 0
            },
            "dismissed": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "unchanged": {
              "const": false
            }
          },
          "anyOf": [
            {
              "properties": {
                "removed": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "kept": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "dismissed": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
