{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/get.output.schema.json",
  "title": "get answer",
  "description": "The memory tool get's answer (SB-P3-09): one memory whole, or one of its states by revision (version), with a notice that its words are data. A memory or state held for review comes without its words, tags or project (D-160). citations (SB-P4-10, migration 055) only when the memory read now cites Drive documents its reader reads, never for a version or a held memory: each checked at its source for this answer; a memory that cites none answers without it, as before. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "memory",
        "version",
        "notice"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "memory": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "memory.defs.schema.json#/$defs/memory"
            }
          ]
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "memory.defs.schema.json#/$defs/version"
            }
          ]
        },
        "notice": {
          "$ref": "memory.defs.schema.json#/$defs/notice"
        },
        "citations": {
          "$ref": "memory.defs.schema.json#/$defs/citations"
        }
      },
      "oneOf": [
        {
          "properties": {
            "memory": {
              "type": "object"
            },
            "version": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "memory": {
              "type": "null"
            },
            "version": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "required": [
                  "citations"
                ]
              }
            },
            {
              "properties": {
                "memory": {
                  "type": "object",
                  "properties": {
                    "held": {
                      "type": "null"
                    }
                  }
                },
                "version": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
