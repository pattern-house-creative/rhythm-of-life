{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/stop_standing.output.schema.json",
  "title": "stop_standing answer",
  "description": "The memory tool stop_standing's answer (SB-P5-12, migration 065): a standing instruction stopped, as a change of the memory: it fires no more and stays a memory; history records standing_stopped, and undo starts it again. A repeat answers unchanged. No memory's words. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "id",
        "revision",
        "scope",
        "owner",
        "status",
        "scopes",
        "project",
        "changed",
        "unchanged",
        "message"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "id": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "revision": {
          "$ref": "memory.defs.schema.json#/$defs/revision"
        },
        "scope": {
          "$ref": "memory.defs.schema.json#/$defs/scope"
        },
        "owner": {
          "$ref": "memory.defs.schema.json#/$defs/subject"
        },
        "status": {
          "$ref": "memory.defs.schema.json#/$defs/status"
        },
        "scopes": {
          "$ref": "memory.defs.schema.json#/$defs/scopes"
        },
        "project": {
          "$ref": "memory.defs.schema.json#/$defs/writtenProject"
        },
        "changed": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "const": "standing"
          }
        },
        "unchanged": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
