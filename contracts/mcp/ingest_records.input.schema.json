{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/ingest_records.input.schema.json",
  "title": "ingest_records arguments",
  "description": "Text records an external plugin writes through MCP. See contracts/README.md section 4.5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "subject", "idempotencyKey", "records"],
  "properties": {
    "provider": { "$ref": "#/$defs/id" },
    "subject": { "$ref": "#/$defs/id" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,200}$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "kind", "title", "text", "fetchedAt"],
        "properties": {
          "externalId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "text": { "type": "string", "maxLength": 40000 },
          "observedAt": { "$ref": "#/$defs/instant" },
          "localDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "timezone": { "$ref": "#/$defs/timezone" },
          "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "type": "string", "pattern": "^https://", "maxLength": 2000 },
          "fetchedAt": { "$ref": "#/$defs/instant" },
          "sourceUpdatedAt": { "$ref": "#/$defs/instant" },
          "metadata": { "type": "object", "maxProperties": 50 },
          "links": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["externalId", "relationship"],
              "properties": {
                "externalId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "relationship": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timezone": { "type": "string", "pattern": "^(UTC|[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2})$" }
  }
}
