{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/app_insights.output.schema.json",
  "title": "app_insights structuredContent",
  "description": "Saved insights, newest first, each with its feedback, and the newest runs a harness logged. Text is untrusted data wherever it is shown. See contracts/README.md section 2.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["insights", "runs"],
  "properties": {
    "insights": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/insight" } },
    "runs": { "type": "array", "maxItems": 14, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "whyItMatters", "nextStep", "points", "evidenceLevel", "limitations", "stars", "sources",
        "generatedBy", "generatedAt", "sourcesAsOf", "supersedes", "status", "feedback", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["focus", "discovery", "suggestion"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "whyItMatters": { "type": "string", "maxLength": 600 },
        "nextStep": { "type": "string", "maxLength": 400 },
        "points": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "type"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 400 },
              "type": { "enum": ["observed", "sourced", "inferred", "hypothesis"] },
              "source": { "type": ["integer", "null"], "minimum": 0, "description": "An index into sources." }
            }
          }
        },
        "evidenceLevel": { "enum": ["strong", "moderate", "weak"] },
        "limitations": { "type": "string", "maxLength": 400 },
        "stars": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["graphId", "title"],
            "properties": { "graphId": { "type": "string", "minLength": 1, "maxLength": 1000 }, "title": { "type": "string", "maxLength": 200 } }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "title", "retrievedAt"],
            "properties": {
              "kind": {
                "enum": ["graph", "record", "document", "memory", "web", "nas", "drive", "second-brain"],
                "description": "nas, drive and second-brain are the private version's names, still accepted."
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "url": { "type": ["string", "null"], "pattern": "^https://", "maxLength": 2048 },
              "locator": { "type": ["string", "null"], "maxLength": 300 },
              "publishedAt": { "$ref": "#/$defs/maybeInstant" },
              "retrievedAt": { "$ref": "#/$defs/instant" }
            }
          }
        },
        "generatedBy": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "generatedAt": { "$ref": "#/$defs/instant" },
        "sourcesAsOf": { "$ref": "#/$defs/instant" },
        "supersedes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
        "status": { "enum": ["new", "saved", "explored", "snoozed", "dismissed", "superseded", "handled"] },
        "feedback": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "at", "until"],
              "properties": {
                "value": { "enum": ["interesting", "explore", "not_useful", "later", "handled"] },
                "at": { "$ref": "#/$defs/instant" },
                "until": { "$ref": "#/$defs/maybeInstant" },
                "note": { "type": ["string", "null"], "maxLength": 500 }
              }
            }
          ]
        },
        "createdAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedBy", "outcome", "note", "insightId", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "generatedBy": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "outcome": { "enum": ["saved", "quiet", "blocked"] },
        "note": { "type": ["string", "null"], "maxLength": 500 },
        "insightId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
        "at": { "$ref": "#/$defs/instant" }
      }
    },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "maybeInstant": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
