{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhythm-of-life.example.invalid/contracts/mcp/link.output.schema.json",
  "title": "link answer",
  "description": "The memory tool link's answer (SB-P4-02, migration 052): one link a person or an AI client made between two memories of one scope, as stored. source and target are the memories as named; from and to as stored (relates_to has no direction and is stored with the smaller id first, so from and to may be target and source). verification is inferred for an AI client's link and verified for a person's (D-015); provenance says the same in upstream's words (system, explicit). created: this call made it (or made a dismissed one anew); unchanged: it was there already and nothing changed. scope, owner and scopes are the source memory's and the install's. No memory's words. Listed and answered only with memory.tools on (contracts/README.md 2.1). The JSON in its text content, and on success the same as its structured content; a refusal is isError true with the refusal body.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "id",
        "source",
        "target",
        "from",
        "to",
        "type",
        "directed",
        "verification",
        "provenance",
        "created",
        "unchanged",
        "scope",
        "owner",
        "scopes",
        "message"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "id": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "source": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "target": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "from": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "to": {
          "$ref": "memory.defs.schema.json#/$defs/uuid"
        },
        "type": {
          "enum": [
            "relates_to",
            "caused_by",
            "decided",
            "about_person",
            "part_of_project",
            "follows",
            "drawn_from"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "verification": {
          "enum": [
            "verified",
            "inferred"
          ]
        },
        "provenance": {
          "enum": [
            "explicit",
            "system"
          ]
        },
        "created": {
          "type": "boolean"
        },
        "unchanged": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "memory.defs.schema.json#/$defs/scope"
        },
        "owner": {
          "$ref": "memory.defs.schema.json#/$defs/subject"
        },
        "scopes": {
          "$ref": "memory.defs.schema.json#/$defs/scopes"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "const": "relates_to"
                },
                "directed": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "type": {
                  "not": {
                    "const": "relates_to"
                  }
                },
                "directed": {
                  "const": true
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "verification": {
                  "const": "verified"
                },
                "provenance": {
                  "const": "explicit"
                }
              }
            },
            {
              "properties": {
                "verification": {
                  "const": "inferred"
                },
                "provenance": {
                  "const": "system"
                }
              }
            }
          ]
        },
        {
          "not": {
            "properties": {
              "created": {
                "const": true
              },
              "unchanged": {
                "const": true
              }
            },
            "required": [
              "created",
              "unchanged"
            ]
          }
        }
      ]
    },
    {
      "$ref": "memory.defs.schema.json#/$defs/refusal"
    }
  ]
}
