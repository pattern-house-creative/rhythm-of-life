#!/bin/sh
# rhythm: run a Rhythm of Life install with nothing but Docker (Compose 2.20 or later). cli/README.md has every command.
#
#   ./rhythm init                 settings, .env and every secret (asks; --no-input and flags for scripts)
#   ./rhythm up | down | logs     start (and print where to go), stop, follow the logs
#   ./rhythm backup | snapshots   an encrypted backup now; the list of backups
#   ./rhythm restore <snapshot>   put a backup back (the current database is kept, renamed)
#   ./rhythm upgrade [<tag>] [--pull]   backup, build or pull, migrate, switch, verify; roll back on failure
#   ./rhythm <anything else>      runs inside the engine image: connect, disconnect, doctor, token, check-config, ...
#
# init records COMPOSE_PROJECT_NAME and RHYTHM_VERSION in deploy/compose/.env, so every later command acts on this
# install's own project and images; they and the other .env names can still be overridden from the environment.
set -eu
cd "$(dirname "$0")"
env_file=deploy/compose/.env
export MSYS_NO_PATHCONV=1 # Git Bash on Windows: pass /paths to docker unchanged (so every path given here is relative)

# Compose runs in deploy/compose, as deploy/backups/backup.sh does, so .env's COMPOSE_FILE (TrueNAS) applies too.
# It gets rhythm.yaml's checksum for the engine and app: Compose does not notice a changed config file on its own, so
# without it `up` would leave them running on the old settings. A project exported in the environment is named to
# Compose as well (-p), as Compose would take it anyway, so a command a test stack runs never rests on what it infers.
dc() { (cd deploy/compose
  f=$(sed -n 's/^RHYTHM_CONFIG_FILE=//p' .env 2>/dev/null | tail -n 1); f=${f:-./rhythm.yaml}
  if [ -f "$f" ]; then RHYTHM_SETTINGS_HASH=$(cksum < "$f" | cut -d ' ' -f 1); export RHYTHM_SETTINGS_HASH; fi
  if [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then docker compose -p "$COMPOSE_PROJECT_NAME" "$@"; else docker compose "$@"; fi); }
cli() { dc --profile cli run --rm cli "$@"; }
up() { cli preflight && dc up -d --wait "$@" && cli ready; }
# A backup, then its staging folder's plain copy removed once restic has it and read it back (as deploy/backups/backup.sh).
backup() { s="/staging/$(date -u +%Y%m%dT%H%M%SZ)"; dc --profile backup run --rm backup backup /var/lib/rhythm/archive "$s" &&
  dc --profile backup run --rm --no-deps --entrypoint rm backup -r "$s"; }
version() { v=${RHYTHM_VERSION:-$(sed -n 's/^RHYTHM_VERSION=//p' "$env_file" 2>/dev/null | tail -n 1)}; echo "${v:-dev}"; }
# The Compose project a command acts on: the environment's, else the one init recorded in .env. Empty when neither names one.
project() { echo "${COMPOSE_PROJECT_NAME:-$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$env_file" 2>/dev/null | tail -n 1)}"; }
retag() { for image in rhythm-engine rhythm-app rhythm-backup; do
  if docker image inspect "$image:$1" >/dev/null 2>&1; then docker tag "$image:$1" "$image:$2"; fi; done; }
# After an upgrade, a reminder that changes nothing: the pins this install builds from or runs that were last checked
# over 90 days ago (deploy/image-pins.txt), and images it runs that the list does not pin, such as an override in .env,
# which no upgrade moves.
pins() { dc config --images 2>/dev/null | sort -u | awk -v today="$(date -u +%Y-%m-%d)" '
  function days(d) { return substr(d, 1, 4) * 365.25 + substr(d, 6, 2) * 30.44 + substr(d, 9, 2) }
  FNR == NR { if ($1 ~ /^#/ || NF < 3) next; since[$1] = $2; if ($3 ~ /Dockerfile$/) used[$1] = 1; next }
  /^rhythm-/ || $0 == "" { next }
  $0 in since { used[$0] = 1; next }
  { print "Not pinned in deploy/image-pins.txt, so no upgrade moves it: " $0 " (an override in .env?)" }
  END { for (image in used) if (since[image] != "floating" && days(today) - days(since[image]) > 90)
    print "Pinned image last checked on " since[image] ", over 90 days ago: " image \
      ". Look for a newer release (deploy/README.md, Pinned images)." }
  ' deploy/image-pins.txt - >&2; }
# Settings changed: recreate a running engine so it reads them, and the app so it asks again which tools the engine
# offers (a connected source's tiles show at once), and start any new adapter containers.
apply() { if [ -n "$(dc ps -q engine 2>/dev/null)" ]; then dc up -d --wait --force-recreate --no-deps engine app && dc up -d --wait; fi; }

command=${1:-help}
[ $# -gt 0 ] && shift
case "$command" in
  init)
    # A new install's project name from --project-name, so init's own container already runs in that project.
    prev=
    for arg in "$@"; do
      if [ "$prev" = --project-name ]; then export COMPOSE_PROJECT_NAME="$arg"; fi
      case "$arg" in --project-name=?*) export COMPOSE_PROJECT_NAME="${arg#--project-name=}" ;; esac
      prev=$arg
    done
    # A first init here (no .env yet) that names no project takes Compose's default one, rhythm. Volumes already under
    # that name are another install's data, and this install would start on them: refused until the project is named.
    if [ ! -f "$env_file" ] && [ -z "${COMPOSE_PROJECT_NAME:-}" ] &&
      [ -n "$(docker volume ls -q --filter label=com.docker.compose.project=rhythm 2>/dev/null)" ]; then
      echo "A Compose project named rhythm already has volumes on this computer: another install's data. A first init here" >&2
      echo "without a project name would start on that data. Nothing was written. Give this install its own project and ports:" >&2
      echo "  ./rhythm init --project-name <name> --app-port <port> --mcp-port <port>   (cli/README.md, Two installs on one computer)" >&2
      echo "To set this checkout up on the existing data on purpose, name it: ./rhythm init --project-name rhythm" >&2
      exit 2
    fi
    cli init "$@" ;;
  up) up ;;
  down)
    # -v deletes the project's volumes: the database and the archive, for good. With no project named (no .env, or none
    # in it, and none in the environment) Compose would take the default one, rhythm, whichever install that is.
    for arg in "$@"; do case "$arg" in -v | --volumes | -[!-]*v*)
      if [ -z "$(project)" ]; then
        echo "This checkout names no Compose project (deploy/compose/.env is missing, or has no COMPOSE_PROJECT_NAME), so" >&2
        echo "down -v would delete the volumes of the default project, rhythm: the database and the archive, whichever" >&2
        echo "install they belong to. Nothing was removed. To delete an install's data on purpose, name its project:" >&2
        echo "  COMPOSE_PROJECT_NAME=<name> ./rhythm down -v" >&2
        exit 2
      fi
      echo "Removing the project $(project) with its volumes: the database and the archive, for good." >&2
      break ;;
    esac; done
    dc down "$@" ;;
  logs) dc logs "$@" ;;
  backup) backup ;;
  snapshots) dc --profile backup run --rm --entrypoint restic backup snapshots ;;
  restore)
    [ $# -eq 1 ] || { echo "usage: ./rhythm restore <snapshot>   (an id from ./rhythm snapshots, or latest)" >&2; exit 2; }
    folder="/staging/restore-$(date -u +%Y%m%dT%H%M%SZ)"
    # The restored folder is a plain copy of the whole database, every scope: it goes once the load is done or has
    # failed (the snapshot keeps it, encrypted). A load that fails leaves the live database as it was (its message
    # says so), so the stack starts again on it.
    # Whatever stops the command before then (a step that fails, Ctrl+C), the folder goes on the way out.
    gone() { dc --profile restore run --rm --no-deps --entrypoint rm restore -rf "$folder" ||
      echo "Remove $folder from the backup staging folder yourself: it is a plain copy of the database." >&2; }
    trap gone EXIT
    trap 'exit 130' INT TERM
    dc --profile restore run --rm restore restore "$1" "$folder" || exit 1
    dc stop engine app
    loaded=0
    dc --profile restore run --rm restore load "$folder" || loaded=$?
    gone
    trap - EXIT INT TERM
    up
    [ "$loaded" = 0 ] || { echo "The restore did not load; the load's message above says what it left as it was." >&2; exit 1; } ;;
  upgrade)
    old=$(version); new=$old; how=build
    for arg in "$@"; do case "$arg" in --pull) how=pull ;; *) new=$arg ;; esac; done
    backup
    retag "$old" "$old-previous"
    export RHYTHM_VERSION="$new"
    # --pull: the base images (.NET, Node, Postgres for pg_dump) follow their patch releases only when pulled again.
    # Recreated even when a tag only moved: Compose does not always notice a rebuilt image under the same tag.
    if { if [ "$how" = pull ]; then dc pull; else dc --profile backup build --pull; fi; } && up --force-recreate; then
      if grep -q '^RHYTHM_VERSION=' "$env_file"; then sed "s/^RHYTHM_VERSION=.*/RHYTHM_VERSION=$new/" "$env_file" > "$env_file.new"
      else { cat "$env_file"; [ -z "$(tail -c 1 "$env_file")" ] || echo; echo "RHYTHM_VERSION=$new"; } > "$env_file.new"; fi
      cat "$env_file.new" > "$env_file" && rm -f "$env_file.new"
      echo "Upgraded to $new. The images before it are tagged $old-previous."
      pins || true
    else
      echo "Upgrade to $new failed: rolling back to $old (the backup above holds the data from before)." >&2
      retag "$old-previous" "$old"
      export RHYTHM_VERSION="$old"
      up --force-recreate
      exit 1
    fi ;;
  connect|disconnect) cli "$command" "$@" && if [ $# -gt 0 ]; then apply; fi ;;
  help|-h|--help) sed -n '3,10s/^# \{0,1\}//p' rhythm; cli help ;;
  *) cli "$command" "$@" ;;
esac
