      "html": "<style>\n.w{display:grid;gap:18px;max-width:880px;margin:0 auto;padding:clamp(12px,3vw,24px) clamp(16px,3vw,24px)}\n.tag{font-size:11px;letter-spacing:.14em;color:var(--rhythm-caution)}\n.w h1{font-size:clamp(20px,2.4vw,26px);margin:2px 0 0}\n.big b{display:block;font-family:var(--rhythm-display);font-weight:500;font-size:clamp(36px,8vw,52px);line-height:1}\n.big span,.note{color:var(--rhythm-muted);font-size:12px}\n.note{margin:0}\n.days{display:flex;gap:5px;align-items:flex-end;height:90px}\n.days i{flex:1;max-width:20px;border-radius:6px;background:var(--rhythm-health)}\n.card{display:none}\nhtml[data-mode=card],html[data-mode=card] body{height:100%;overflow:hidden}\nhtml[data-mode=card] .w{display:none}\nhtml[data-mode=card] .card{display:flex;flex-direction:column;justify-content:center;gap:12px;height:100%;padding:2px}\nhtml[data-shape=compact] .card .days{display:none}\nhtml[data-shape=tall] .card{justify-content:flex-start;padding-top:8px}\nhtml[data-shape=tall] .card .days{flex:1 1 auto;height:auto;min-height:60px}\n</style>\n<div class=\"card\">\n  <div class=\"big\"><b data-k=\"week\">—</b><span>average mood this week, of 5</span></div>\n  <div class=\"days\" data-c></div>\n  <p class=\"note\" data-k=\"latest\"></p>\n</div>\n<div class=\"w\">\n  <div><div class=\"tag\">DEMO</div><h1>Mood log</h1></div>\n  <div class=\"big\"><b data-k=\"week\">—</b><span>average this week, of 5</span></div>\n  <div class=\"days\" data-c role=\"img\" aria-label=\"Mood each evening, the last 14 days\"></div>\n  <p class=\"note\" data-k=\"latest\"></p>\n  <p class=\"note\">Fictional evening check-ins from one to five, the last 14 days.</p>\n</div>\n<script>\nrhythm.onData(function (d) {\n  var f = d.feeds.mood, rows = f && f.status === \"ok\" ? f.rows : [], week = rows.slice(-7), last = rows[rows.length - 1];\n  function put(k, text) { document.querySelectorAll(\"[data-k=\" + k + \"]\").forEach(function (e) { e.textContent = text; }); }\n  put(\"week\", week.length ? (week.reduce(function (a, r) { return a + r.mean; }, 0) / week.length).toFixed(1) : \"—\");\n  put(\"latest\", f && f.status !== \"ok\" ? \"The mood log is unavailable: \" + f.reason\n    : last ? \"Latest check-in: \" + Math.round(last.mean) + \" of 5, on \" + last.date : \"No check-ins yet\");\n  document.querySelectorAll(\"[data-c]\").forEach(function (el) {\n    el.textContent = \"\";\n    rows.forEach(function (r, i) {\n      var day = document.createElement(\"i\");\n      day.style.height = Math.max(8, r.mean / 5 * 100) + \"%\";\n      day.style.opacity = i >= rows.length - 7 ? 0.9 : 0.4;\n      day.title = r.date + \": \" + r.mean + \" of 5\";\n      el.appendChild(day);\n    });\n  });\n});\n</script>"
    }
