#!/bin/sh
# Entry point of the engine image: `rhythm-engine <command>` (serve, migrate, token, refresh, check-config), and
# `healthcheck`, which asks the running engine's /health without starting another .NET process.
set -eu
if [ "${1:-}" = "healthcheck" ]; then
  exec bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /health HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 && head -n 1 <&3 | grep -q " 200 "'
fi
exec dotnet /app/Knowledge.dll "$@"
