<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <ProjectReference Include="../../src/Core/Knowledge.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared synthetic fixtures: the contract's examples and the engine's demo seed. -->
    <Content Include="../../../contracts/fixtures/*.json" Link="contracts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../contracts/mcp/*.json" Link="contracts/mcp/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../contracts/adapters/*.json" Link="contracts/adapters/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../demo/engine/*.json" Link="demo/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../deploy/compose/rhythm.example.yaml" Link="rhythm.example.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fictional sample folders a newcomer can point the notes, csv and documents adapters at. -->
    <Content Include="../../../demo/notes/**/*" Link="samples/notes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../demo/import/**/*" Link="samples/import/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The synthetic Second Brain parity corpus and its golden queries (Parity/). -->
    <None Update="Parity/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
