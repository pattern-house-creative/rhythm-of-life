# .env.example: the compose-level settings of one install. Names only, no values.
#
# Copy to .env next to this file (or let `rhythm init` write it). .env is never committed.
# Nothing in .env is secret: secrets are files under secrets/ (see docs/configuration.md).
# An empty or missing value means the default shown in compose.yaml.

# Docker Compose project name: the stack's containers, networks and volumes are named after it (default: rhythm).
# A second install on the same computer needs its own; rhythm init asks for it (--project-name).
COMPOSE_PROJECT_NAME=

# Image tag for the app and engine images built from this repo (default: dev); rhythm init records the
# current one and rhythm upgrade sets it
RHYTHM_VERSION=

# Which settings file the containers read (default: ./rhythm.example.yaml, demo mode)
# rhythm init sets it to ./rhythm.yaml
RHYTHM_CONFIG_FILE=

# Address the published ports listen on (default: 127.0.0.1, this computer only)
# 0.0.0.0 for the home network; leave the default for Tailscale or Cloudflare recipes
RHYTHM_BIND=

# Host port of the app (default: 8080)
RHYTHM_APP_PORT=

# Host port of the engine's MCP endpoint for MCP clients on this computer (default: 8181)
RHYTHM_MCP_PORT=

# Overrides engine.url from rhythm.yaml for the app's server (default: empty, use the file)
RHYTHM_ENGINE_URL=

# Host folders mounted read-only into the engine (defaults: ./data/notes and ./data/import):
# your Markdown notes, and the files you import (CSV files; documents in its documents/ folder).
# The fictional samples: ../../demo/notes and ../../demo/import
RHYTHM_NOTES_DIR=
RHYTHM_IMPORT_DIR=

# Host folders for backups (docs/backups.md): the encrypted restic repository and the staging folders
# (defaults: ./data/backups and ./data/backup-staging)
RHYTHM_BACKUP_DIR=
RHYTHM_BACKUP_STAGING_DIR=

# Postgres image with pgvector (default: pgvector/pgvector:0.8.7-pg17-bookworm)
RHYTHM_POSTGRES_IMAGE=

# The database and its owner (defaults: rhythm and rhythm_admin). Only an install whose database already has other
# names sets them, such as one moved from an older engine (docs/dev/migration-compat.md)
RHYTHM_DB_NAME=
RHYTHM_DB_ADMIN_USER=

# Optional adapter containers to start, comma-separated profile names (for example titles)
# Exposure recipes: tailscale, cloudflare, openai-tunnel (deploy/exposure/)
COMPOSE_PROFILES=

# The titles profile: Ollama image (default: ollama/ollama:0.40.13) and its memory limit (default: 4g)
RHYTHM_OLLAMA_IMAGE=
RHYTHM_TITLES_MEMORY=

# Tailscale recipe: the machine name on your tailnet (default: rhythm), and an image override
RHYTHM_TAILSCALE_HOSTNAME=
RHYTHM_TAILSCALE_IMAGE=

# Cloudflare recipe: an image override (default: a pinned cloudflare/cloudflared)
RHYTHM_CLOUDFLARED_IMAGE=

# OpenAI tunnel recipe: an image override (default: a pinned ghcr.io/openai/tunnel-client)
RHYTHM_OPENAI_TUNNEL_IMAGE=

# Reverse-proxy example (deploy/exposure/reverse-proxy/): the site name, where the proxy listens
# (defaults: localhost, 0.0.0.0, ports 80 and 443), and an image override
RHYTHM_SITE=
RHYTHM_PROXY_BIND=
RHYTHM_PROXY_HTTP_PORT=
RHYTHM_PROXY_HTTPS_PORT=
RHYTHM_CADDY_IMAGE=

# TrueNAS (deploy/truenas/): folders on your dataset for the database and the engine's data
RHYTHM_PGDATA_DIR=
RHYTHM_ENGINE_DATA_DIR=
