{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run verify",
  "outputDirectory": "dist",
  "functions": {
    "api/screens.ts": { "maxDuration": 60, "supportsCancellation": true }
  },
  "rewrites": [
    { "source": "/api/status", "destination": "/api/sources?route=status" },
    { "source": "/api/sync", "destination": "/api/sources?route=sync" },
    { "source": "/api/memories", "destination": "/api/sources?route=memories" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
